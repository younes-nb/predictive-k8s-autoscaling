/load_testing/venv
.venv
venv
/local_data
/data/
/analytics/data/
*.pyc
__pycache__/
# Generated load-test credentials (local-only; regenerate via
# load_testing/seed_tt_users.py, never commit)
load_testing/seeds/tt_users.json
load_testing/seeds/tt_users_12k.json
# PBScaler collected datasets + HPA state are local artifacts
pbscaler/data/
# PBScaler log artifacts (moved to /proj/k8sautoscaledl-PG0/reports)
pbscaler/simulation/train_ticket/*.log
pbscaler/simulation/train_ticket/*.txt
AGENTS.md
# Experiment run directories: logs, dumps and datasets are large local
# artifacts, not source. Without this every snapshot (opencode and git) copies
# gigabytes of run data — one 4 h run reached 18 GB of snapshots and filled the
# 63 GB loadgen disk.
stage7_28/exp13jul/hpa*/
stage7_28/exp13jul/smoke_*/
stage7_28/exp13jul/dryruns/
# Every run directory is <name>_<UTC timestamp> (e.g. step1_hpa_30k_jul13_20261117T221258Z).
stage7_28/exp13jul/step*/
stage7_28/exp13jul/*_20[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z/
# Same rule for the prefixes that are not step*: cal_*, probe_*, gwsmoke_*,
# dryrun_* all produce <prefix>_<UTCstamp> run dirs with the same layout.
stage7_28/exp13jul/cal_*/
stage7_28/exp13jul/probe_*/
stage7_28/exp13jul/gwsmoke_*/
stage7_28/exp13jul/gwverify_*/
# k6 outputs must never land in the repo. launch_k6.sh defaults OUT_DIR to
# $PWD/k6; run_experiment.sh now passes K6_OUT_DIR explicitly, but keep this as
# a guard so a stray run cannot dirty the tree.
k6/

# AURORA-HPA: training corpora, model artifacts and the staged build context are
# large binaries, not source. Regenerate with aurora/train/*.py and
# aurora/deploy/build_and_push.sh.
aurora/data/
aurora/build_model/

# AURORA-R: the local virtualenv and the staged docker build context are
# generated, not source (the venv alone is ~500 MB of binaries). Recreate with
#   python3 -m venv .venv-aurorar && .venv-aurorar/bin/pip install -r aurora_r/requirements.txt
#   aurora_r/deploy/build_and_push.sh
.venv-aurorar/
build_ctx/
