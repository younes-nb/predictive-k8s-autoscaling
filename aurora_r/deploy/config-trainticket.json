{
  "namespace": "train-ticket",
  "front_workload": "ts-ui-dashboard",
  "slo_budget_ms": 200.0,
  "slo_source": "auto",
  "prometheus_url": "http://127.0.0.1:18080/prometheus",
  "checkpoint": "/opt/aurora-r/registry/bundle.pt",
  "mode": "shadow",
  "telemetry_step_s": 5,
  "decision_interval_s": 15.0,
  "history_points": 24,
  "telemetry_timeout_s": 7.0,
  "telemetry_workers": 8,
  "max_neighbors_per_caller": 12,
  "max_edges": 15000,
  "top_k_out": 5,
  "top_k_in": 5,
  "slo_window_s": 120,
  "min_slo_eligible": 20,
  "max_slo_age_s": 20,
  "max_metric_age_s": 20,
  "max_scale_out_step": 3,
  "max_scale_in_step": 2,
  "scale_in_health_s": 300,
  "min_settle_after_ready_s": 65,
  "max_rollout_s": 900,
  "experimental_actuation_ack": false,
  "journal_path": "/var/lib/aurora-r/actions.sqlite3",
  "adapter_path": "/var/lib/aurora-r/adapter.json",
  "lease_name": "aurora-r-writer",
  "targets": [
    {"deployment": "ts-ui-dashboard",        "istio_workload": "ts-ui-dashboard",        "min_replicas": 1, "max_replicas": 10, "service_name": "ts-ui-dashboard"},
    {"deployment": "ts-auth-service",        "istio_workload": "ts-auth-service",        "min_replicas": 1, "max_replicas": 10, "service_name": "ts-auth-service"},
    {"deployment": "ts-user-service",        "istio_workload": "ts-user-service",        "min_replicas": 1, "max_replicas": 10, "service_name": "ts-user-service"},
    {"deployment": "ts-order-service",       "istio_workload": "ts-order-service",       "min_replicas": 1, "max_replicas": 10, "service_name": "ts-order-service"},
    {"deployment": "ts-travel-service",      "istio_workload": "ts-travel-service",      "min_replicas": 1, "max_replicas": 10, "service_name": "ts-travel-service"},
    {"deployment": "ts-route-service",       "istio_workload": "ts-route-service",       "min_replicas": 1, "max_replicas": 10, "service_name": "ts-route-service"},
    {"deployment": "ts-contacts-service",    "istio_workload": "ts-contacts-service",    "min_replicas": 1, "max_replicas": 10, "service_name": "ts-contacts-service"},
    {"deployment": "ts-food-service",        "istio_workload": "ts-food-service",        "min_replicas": 1, "max_replicas": 10, "service_name": "ts-food-service"},
    {"deployment": "ts-payment-service",     "istio_workload": "ts-payment-service",     "min_replicas": 1, "max_replicas": 10, "service_name": "ts-payment-service"},
    {"deployment": "ts-station-service",     "istio_workload": "ts-station-service",     "min_replicas": 1, "max_replicas": 10, "service_name": "ts-station-service"},
    {"deployment": "ts-seat-service",        "istio_workload": "ts-seat-service",        "min_replicas": 1, "max_replicas": 10, "service_name": "ts-seat-service"},
    {"deployment": "ts-security-service",    "istio_workload": "ts-security-service",    "min_replicas": 1, "max_replicas": 10, "service_name": "ts-security-service"},
    {"deployment": "ts-preserve-service",    "istio_workload": "ts-preserve-service",    "min_replicas": 1, "max_replicas": 10, "service_name": "ts-preserve-service"},
    {"deployment": "ts-ticketinfo-service",  "istio_workload": "ts-ticketinfo-service",  "min_replicas": 1, "max_replicas": 10, "service_name": "ts-ticketinfo-service"},
    {"deployment": "ts-basic-service",       "istio_workload": "ts-basic-service",       "min_replicas": 1, "max_replicas": 10, "service_name": "ts-basic-service"},
    {"deployment": "ts-assurance-service",   "istio_workload": "ts-assurance-service",   "min_replicas": 1, "max_replicas": 10, "service_name": "ts-assurance-service"},
    {"deployment": "ts-price-service",       "istio_workload": "ts-price-service",       "min_replicas": 1, "max_replicas": 10, "service_name": "ts-price-service"},
    {"deployment": "ts-news-service",        "istio_workload": "ts-news-service",        "min_replicas": 1, "max_replicas": 10, "service_name": "ts-news-service"},
    {"deployment": "ts-notification-service","istio_workload": "ts-notification-service","min_replicas": 1, "max_replicas": 10, "service_name": "ts-notification-service"},
    {"deployment": "ts-voucher-service",     "istio_workload": "ts-voucher-service",     "min_replicas": 1, "max_replicas": 10, "service_name": "ts-voucher-service"}
  ]
}